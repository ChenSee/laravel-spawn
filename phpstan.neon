parameters:
    level: 0
    paths:
        - src
    customRulesetUsed: true
    ignoreErrors:
        - identifier: new.static
        - identifier: ignore.unmatchedLine
        # For $attempts >= 1 transaction() leaves its retry loop only by returning or by
        # rethrowing from one of the handlers, so the tail after the loop is unreachable.
        # PHPStan does not follow that through handleTransactionException() and asks for
        # a return. Laravel's own transaction() returns null for $attempts <= 0 too.
        -
            message: '#^Method .+::(transaction|coroutineTransaction)\(\) should return TReturn but return statement is missing\.$#'
            identifier: return.missing
            path: src/Database/CoroutineTransactions.php
        # The relation subclasses declare $constraints to shadow the property of the same name
        # on Relation, which is the one every coroutine of a worker thread shares. Eloquent's
        # addConstraints() reads it through late static binding, so the inherited body consults
        # the subclass copy. Nothing writes that copy — see the note on the trait — so it leaks
        # nothing; PHP simply has no way to declare a readonly static.
        -
            identifier: coroutine.mutableStaticProperty
            path: src/Database/Eloquent/Relations/ConstrainsPerCoroutine.php

rules:
    - Spawn\Laravel\PHPStan\MutableStaticPropertyRule

services:
    # An application that scopes services of its own lists their types in
    # perRequestTypes: the container reads config('async.scoped_services') at runtime,
    # and static analysis has no container to ask.
    -
        class: Spawn\Laravel\PHPStan\SingletonCapturesPerRequestRule
        arguments:
            perRequestTypes: []
        tags:
            - phpstan.rules.rule
